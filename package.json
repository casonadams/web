{
  "name": "web",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Web search and content fetching tools for pi.",
  "license": "MIT",
  "author": "Cason Adams",
  "packageManager": "pnpm@11.21.0",
  "keywords": [
    "pi-package",
    "pi-extension",
    "web-search",
    "web-fetch"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/casonadams/web.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "html-to-text": "^10.0.0",
    "ipaddr.js": "^2.5.0",
    "linkedom": "^0.18.13",
    "undici": "^8.10.0",
    "unpdf": "^1.8.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": ">=0.80.7",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^26.2.0",
    "typebox": "1.3.12",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@google/genai",
      "protobufjs"
    ]
  }
}
